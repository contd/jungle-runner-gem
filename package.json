{
  "name": "jungle-run",
  "private": true,
  "version": "1.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run && node --test tools/version-tests.mjs tools/release-tests.mjs",
    "version": "node tools/sync-version.mjs",
    "version:sync": "node tools/sync-version.mjs",
    "version:check": "node tools/sync-version.mjs --check",
    "tauri": "tauri",
    "docs:install": "bun install --cwd tools/docs --frozen-lockfile",
    "docs": "npm --prefix tools/docs run build",
    "docs:preview": "vite preview --outDir docs --port 4174"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "phaser": "^3.88.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@tauri-apps/cli": "^2.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
