{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Jungle Run - Application and Test Reference",
  "entryPoints": ["src", "tests"],
  "entryPointStrategy": "expand",
  "tsconfig": "tsconfig.json",
  "out": "docs",
  "json": "docs/api.json",
  "readme": "README.md",
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "json5",
    "yaml",
    "tsx",
    "typescript",
    "powershell"
  ],
  "excludePrivate": false,
  "excludeProtected": false,
  "excludeExternals": true,
  "githubPages": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "invalidLink": true,
    "notExported": true,
    "notDocumented": true
  },
  "navigationLinks": {
    "Native shell (rustdoc)": "./native/jungle_run_lib/index.html",
    "Desktop entry point (rustdoc)": "./native/jungle_run/index.html"
  }
}
